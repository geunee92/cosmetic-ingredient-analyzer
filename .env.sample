# ===== AI Provider Keys =====
# 두 키 모두 필수 (멀티 폴백). 한 쪽만 있어도 동작하지만 폴백 비활성화.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ===== Vercel KV (Rate Limit 저장소) =====
# Vercel 대시보드 → Storage → KV 생성 후 자동 주입됨
# 로컬에서는 `vercel env pull .env.local` 로 가져오기
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# ===== 개발 전용 우회 =====
# 데모/디버깅 시에만 사용. 프로덕션 빌드에서는 무시.
# 1로 설정 시 rate limit 카운터 무시.
SKIP_RATE_LIMIT=0
